# Copie para .env.elevenlabs (não vai para o git) e preencha.
# Uso: node --env-file=.env.elevenlabs gerar-audio.cjs gerar m00

# Chave da API: elevenlabs.io → Developers → API Keys
ELEVENLABS_API_KEY=

# Voz escolhida (ID): elevenlabs.io → Voices → … → Copy voice ID  (ou: node gerar-audio.cjs vozes)
ELEVENLABS_VOICE_ID=

# Modelo: eleven_multilingual_v2 = melhor qualidade em português para narração longa
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_OUTPUT=mp3_44100_128

# Ajustes da voz (ver README.md, "Ajuste fino da voz")
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_STYLE=0.15
ELEVENLABS_SPEAKER_BOOST=true
ELEVENLABS_SPEED=1.0

# Pausa entre cenas (segundos) e requisições simultâneas
PAUSA_ENTRE_CENAS=0.8
ELEVENLABS_CONCORRENCIA=2

# Caminho do ffmpeg, se não estiver no PATH (usado só pelo comando "juntar")
# FFMPEG=/usr/bin/ffmpeg
